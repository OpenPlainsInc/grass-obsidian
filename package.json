{
  "name": "grass",
  "version": "0.1.2",
  "description": "Display and summarize GRASS projects in Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "grass-gis",
    "gis",
    "geospatial"
  ],
  "author": "Corey White",
  "license": "MIT",
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^24.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.5.7",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5",
    "vitest": "^4.0.0"
  }
}
